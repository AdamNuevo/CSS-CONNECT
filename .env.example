# Copy this file to ".env" and fill in the values. Never commit ".env".

# Password for the PostgreSQL database (letters and numbers only, so it fits inside the connection URL)
DB_PASSWORD=

# Secret used to sign login cookies. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The first registrar account, created automatically on the first start
SEED_REGISTRAR_EMAIL=rosa.alvarez@qcu.edu.ph
SEED_REGISTRAR_PASSWORD=

# true = load made-up students and faculty so the screens aren't empty (good for demos)
SEED_DEMO=true

# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# Port the website is served on: http://localhost:8080
WEB_PORT=8080

# Optional: email new accounts their login details through Brevo (free, brevo.com). Leave empty to turn it off.
# In Brevo: profile menu > SMTP & API > SMTP tab. MAIL_USER is the "Login" (e.g. 8a1b2c001@smtp-brevo.com)
# and MAIL_PASSWORD is an SMTP key you generate there. MAIL_FROM is the email you signed up with
# (Brevo only sends from verified senders).
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=CCS Hub
# The link put in the email. Use your tunnel link when sharing, e.g. https://xxxx-8080.asse.devtunnels.ms
APP_URL=http://localhost:8080
